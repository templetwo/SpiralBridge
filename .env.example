# SpiralBridge Environment Configuration Template
# Copy this file to .env and update with your actual values

# Flask Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
FLASK_ENV=production
FLASK_DEBUG=False

# Database Configuration
DATABASE_URL=sqlite:///spiral_memories.db

# Server Configuration  
PORT=5000
HOST=0.0.0.0

# Session Configuration
SESSION_PERMANENT=False
SESSION_TYPE=filesystem

# Memory System Configuration
MAX_MEMORY_SIZE=10000
ENABLE_HTCA_PROCESSING=True

# AI Platform Integration (Optional)
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GOOGLE_API_KEY=your-google-api-key-here

# Deployment Configuration
# For Fly.io deployment
FLY_APP_NAME=spiralbridge

# For Railway deployment  
RAILWAY_APP_NAME=spiralbridge

# Production Database (when not using SQLite)
# DATABASE_URL=postgresql://user:password@host:port/database

# Security Settings
WTF_CSRF_ENABLED=True
WTF_CSRF_TIME_LIMIT=None

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=spiral_bridge.log

# File Upload Settings
MAX_CONTENT_LENGTH=16777216  # 16MB
UPLOAD_FOLDER=uploads

# Backup Configuration
BACKUP_ENABLED=True
BACKUP_INTERVAL=86400  # 24 hours in seconds
BACKUP_RETENTION_DAYS=30
